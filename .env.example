# Groq API key (console.groq.com). 비어 있으면 /api/analyze 는 자동으로 MOCK 모드로 동작한다.
GROQ_API_KEY=

# 호출 모델 (제출 문서와 반드시 일치시킬 것)
# 주의: 이 계정에서 실제로 응답하는 모델은 openai/gpt-oss-20b / 120b 뿐이다.
# llama-3.3-70b-versatile · llama-3.1-8b-instant · kimi-k2-instruct · qwen3-32b 는
# 404 model_not_found, gemma2-9b-it 은 decommissioned 였다(라이브 확인함).
GROQ_MODEL=openai/gpt-oss-20b

# 강제 목 모드: 1 이면 키가 있어도 LLM 을 호출하지 않는다 (시연 안전장치)
OFW_FORCE_MOCK=
